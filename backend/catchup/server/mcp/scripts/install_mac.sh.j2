#!/usr/bin/env bash
set -euo pipefail

MCP_URL="{{ mcp_url }}"
CONFIG_DIR="$HOME/Library/Application Support/Claude"
CONFIG_FILE="$CONFIG_DIR/claude_desktop_config.json"

exit_script() {
    local code="${1:-0}"
    echo ""
    echo "아무 키나 누르면 창이 닫힙니다."
    read -r -s -n 1
    exit "$code"
}

echo "CatchUp MCP 설치"
echo ""

# Node.js
if command -v node &>/dev/null; then
    echo "Node.js $(node --version)"
else
    echo "Node.js 설치 중..."
    if ! command -v brew &>/dev/null; then
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || {
            echo "Homebrew 설치 실패. 직접 설치 후 다시 실행하세요: https://nodejs.org/ko/download"
            exit_script 1
        }
        if [[ -f /opt/homebrew/bin/brew ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        fi
    fi
    brew install node || {
        echo "Node.js 설치 실패. 직접 설치 후 다시 실행하세요: https://nodejs.org/ko/download"
        exit_script 1
    }
    echo "Node.js $(node --version) 설치됨"
fi

# Claude Desktop
if [[ ! -d "$CONFIG_DIR" ]]; then
    echo "Claude Desktop을 찾을 수 없습니다. 설치 후 다시 실행하세요: https://claude.ai/download"
    exit_script 1
fi

# jq
if ! command -v jq &>/dev/null; then
    echo "jq 설치 중..."
    brew install jq || {
        echo "jq 설치 실패."
        exit_script 1
    }
fi

# config 파일
_is_new_file=false
if [[ ! -f "$CONFIG_FILE" ]]; then
    printf '{}' > "$CONFIG_FILE"
    _is_new_file=true
fi

# 기존 항목 확인
if jq -e '.mcpServers["Catch Up"]' "$CONFIG_FILE" &>/dev/null; then
    echo ""
    read -r -p "'Catch Up' 설정이 이미 있습니다. 덮어쓰겠습니까? (y/N): " answer
    if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        echo "취소됨."
        exit_script 0
    fi
fi

# 백업
if [[ "$_is_new_file" != "true" ]]; then
    cp "$CONFIG_FILE" "${CONFIG_FILE}.bak"
    echo "기존 설정 백업: ${CONFIG_FILE}.bak"
fi

# 설정 업데이트
FILTER_FILE=$(mktemp)
printf '.mcpServers[$key] = {"command":"npx","args":["-y","mcp-remote",$url,"--transport","http-only"]}' > "$FILTER_FILE"
UPDATED=$(jq --arg url "$MCP_URL" --arg key "Catch Up" -f "$FILTER_FILE" "$CONFIG_FILE"); JQ_EXIT=$?
rm -f "$FILTER_FILE"
if [[ $JQ_EXIT -ne 0 ]] || [[ -z "$UPDATED" ]]; then
    echo "설정 파일 업데이트 실패."
    exit_script 1
fi
printf '%s' "$UPDATED" > "$CONFIG_FILE"

echo ""
echo "설치 완료."
echo "Claude Desktop을 재시작하면 Catch Up MCP가 활성화됩니다."
exit_script 0
