$ErrorActionPreference = "Stop"

$MCP_URL = "{{ mcp_url }}"
$ConfigDir = "$env:APPDATA\Claude"
$ConfigFile = "$ConfigDir\claude_desktop_config.json"

function Refresh-Path {
    $m = [System.Environment]::GetEnvironmentVariable("PATH", "Machine")
    $u = [System.Environment]::GetEnvironmentVariable("PATH", "User")
    $env:PATH = "$m;$u"
}

# JS를 임시 파일로 써서 실행 - node -e는 PowerShell이 따옴표를 제거해 파싱 오류 발생.
$jsScript = @'
var fs = require("fs");
var action = process.argv[2];
var file = process.argv[3];
var url = process.argv[4];

function stripJsonc(text) {
  var out = "", inStr = false, i = 0;
  while (i < text.length) {
    if (inStr) {
      if (text[i] === "\\") { out += text[i] + text[i+1]; i += 2; }
      else if (text[i] === "\"") { out += text[i++]; inStr = false; }
      else { out += text[i++]; }
    } else {
      if (text[i] === "\"") { out += text[i++]; inStr = true; }
      else if (text[i]==="/" && text[i+1]==="/") { while (i<text.length && text[i]!=="\n") i++; }
      else if (text[i]==="/" && text[i+1]==="*") { i+=2; while (i<text.length && !(text[i]==="*" && text[i+1]==="/")) i++; i+=2; }
      else { out += text[i++]; }
    }
  }
  return out.replace(/,(\s*[}\]])/g, "$1");
}

function readConfig(f) {
  var raw = fs.readFileSync(f, "utf8").replace(/^﻿/, "");
  return JSON.parse(stripJsonc(raw));
}

if (action === "check") {
  try {
    var c = readConfig(file);
    process.stdout.write(c.mcpServers && c.mcpServers["Catch Up"] ? "exists" : "");
  } catch(e) { process.stdout.write(""); }
} else if (action === "update") {
  var config = readConfig(file);
  if (!config.mcpServers) config.mcpServers = {};
  config.mcpServers["Catch Up"] = {
    command: "npx",
    args: ["-y", "mcp-remote", url, "--transport", "http-only"]
  };
  fs.writeFileSync(file, JSON.stringify(config, null, 2), "utf8");
}
'@

function _Main {
    # Node.js
    if (Get-Command node -ErrorAction SilentlyContinue) {
        Write-Host "Node.js $(node --version)"
    } else {
        Write-Host "Node.js 설치 중..."
        if (Get-Command winget -ErrorAction SilentlyContinue) {
            winget install --id OpenJS.NodeJS.LTS --accept-source-agreements --accept-package-agreements
            Refresh-Path
        } elseif (Get-Command choco -ErrorAction SilentlyContinue) {
            choco install nodejs-lts -y
            Refresh-Path
        } else {
            Set-ExecutionPolicy Bypass -Scope Process -Force
            [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072
            Invoke-Expression ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))
            Refresh-Path
            choco install nodejs-lts -y
            Refresh-Path
        }
        if (!(Get-Command node -ErrorAction SilentlyContinue)) {
            Write-Host "Node.js 설치 실패. 직접 설치 후 다시 실행하세요: https://nodejs.org/ko/download" -ForegroundColor Red
            Read-Host "Enter를 누르면 종료됩니다"
            return
        }
        Write-Host "Node.js $(node --version) 설치됨"
    }

    # Claude Desktop
    if (!(Test-Path $ConfigDir)) {
        Write-Host "Claude Desktop을 찾을 수 없습니다. 설치 후 다시 실행하세요: https://claude.ai/download" -ForegroundColor Red
        Read-Host "Enter를 누르면 종료됩니다"
        return
    }

    # JS 임시 파일 생성
    $jsFile = [System.IO.Path]::GetTempFileName() + ".js"
    [System.IO.File]::WriteAllText($jsFile, $jsScript, [System.Text.UTF8Encoding]::new($false))

    try {
        # config 파일
        $isNewFile = $false
        if (!(Test-Path $ConfigFile)) {
            [System.IO.File]::WriteAllText($ConfigFile, '{}', [System.Text.UTF8Encoding]::new($false))
            $isNewFile = $true
        }

        # 기존 항목 확인
        $existingEntry = node $jsFile check $ConfigFile
        if ($existingEntry -eq 'exists') {
            $answer = Read-Host "'Catch Up' 설정이 이미 있습니다. 덮어쓰겠습니까? (y/N)"
            if ($answer -notmatch '^[Yy]$') {
                Write-Host "취소됨."
                return
            }
        }

        # 백업
        if ($isNewFile -ne $true) {
            Copy-Item -Path $ConfigFile -Destination "$ConfigFile.bak" -Force
            Write-Host "기존 설정 백업: $ConfigFile.bak"
        }

        # 설정 업데이트
        node $jsFile update $ConfigFile $MCP_URL
        if ($LASTEXITCODE -ne 0) {
            Write-Host "설정 파일 업데이트 실패." -ForegroundColor Red
            Read-Host "Enter를 누르면 종료됩니다"
            return
        }
    } finally {
        Remove-Item $jsFile -ErrorAction SilentlyContinue
    }

    Write-Host ""
    Write-Host "설치 완료." -ForegroundColor Green
    Write-Host "Claude Desktop을 재시작하면 Catch Up MCP가 활성화됩니다."
    Read-Host "Enter를 누르면 종료됩니다"
}

Write-Host "CatchUp MCP 설치"
Write-Host ""

try {
    _Main
} catch {
    Write-Host ""
    Write-Host "오류 발생: $_" -ForegroundColor Red
    Read-Host "Enter를 누르면 종료됩니다"
}
