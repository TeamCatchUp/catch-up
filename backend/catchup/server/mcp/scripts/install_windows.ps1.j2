$ErrorActionPreference = "Stop"

trap {
    Write-Host ""
    Write-Host "오류 발생: $_" -ForegroundColor Red
    Read-Host "Enter를 누르면 종료됩니다"
    exit 1
}

$MCP_URL = "{{ mcp_url }}"
$ConfigDir = "$env:APPDATA\Claude"
$ConfigFile = "$ConfigDir\claude_desktop_config.json"

function Exit-Script {
    param([int]$Code = 0)
    Read-Host "Enter를 누르면 종료됩니다"
    exit $Code
}

Write-Host "CatchUp MCP 설치"
Write-Host ""

# Node.js
if (Get-Command node -ErrorAction SilentlyContinue) {
    Write-Host "Node.js $(node --version)"
} else {
    Write-Host "Node.js 설치 중..."
    if (Get-Command winget -ErrorAction SilentlyContinue) {
        winget install --id OpenJS.NodeJS.LTS --accept-source-agreements --accept-package-agreements
        $env:PATH = [System.Environment]::GetEnvironmentVariable("PATH", "Machine") + ";" +
                    [System.Environment]::GetEnvironmentVariable("PATH", "User")
    } elseif (Get-Command choco -ErrorAction SilentlyContinue) {
        choco install nodejs-lts -y
        $env:PATH = [System.Environment]::GetEnvironmentVariable("PATH", "Machine") + ";" +
                    [System.Environment]::GetEnvironmentVariable("PATH", "User")
    } else {
        Set-ExecutionPolicy Bypass -Scope Process -Force
        [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072
        Invoke-Expression ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))
        $env:PATH = [System.Environment]::GetEnvironmentVariable("PATH", "Machine") + ";" +
                    [System.Environment]::GetEnvironmentVariable("PATH", "User")
        choco install nodejs-lts -y
        $env:PATH = [System.Environment]::GetEnvironmentVariable("PATH", "Machine") + ";" +
                    [System.Environment]::GetEnvironmentVariable("PATH", "User")
    }
    if (!(Get-Command node -ErrorAction SilentlyContinue)) {
        Write-Host "Node.js 설치 실패. 직접 설치 후 다시 실행하세요: https://nodejs.org/ko/download" -ForegroundColor Red
        Exit-Script 1
    }
    Write-Host "Node.js $(node --version) 설치됨"
}

# Claude Desktop
if (!(Test-Path $ConfigDir)) {
    Write-Host "Claude Desktop을 찾을 수 없습니다. 설치 후 다시 실행하세요: https://claude.ai/download" -ForegroundColor Red
    Exit-Script 1
}

# jq
if (!(Get-Command jq -ErrorAction SilentlyContinue)) {
    Write-Host "jq 설치 중..."
    winget install --id stedolan.jq --accept-source-agreements --accept-package-agreements
    $env:PATH = [System.Environment]::GetEnvironmentVariable("PATH", "Machine") + ";" +
                [System.Environment]::GetEnvironmentVariable("PATH", "User")
    if (!(Get-Command jq -ErrorAction SilentlyContinue)) {
        Write-Host "jq 설치 실패." -ForegroundColor Red
        Exit-Script 1
    }
}

# config 파일
$isNewFile = $false
if (!(Test-Path $ConfigFile)) {
    [System.IO.File]::WriteAllText($ConfigFile, '{}', [System.Text.UTF8Encoding]::new($false))
    $isNewFile = $true
}

# 기존 항목 확인
$existingEntry = Get-Content $ConfigFile -Raw | jq -r --arg key "Catch Up" '.mcpServers[$key] // empty'
if ($existingEntry) {
    $answer = Read-Host "'Catch Up' 설정이 이미 있습니다. 덮어쓰겠습니까? (y/N)"
    if ($answer -notmatch '^[Yy]$') {
        Write-Host "취소됨."
        Exit-Script 0
    }
}

# 백업
if ($isNewFile -ne $true) {
    Copy-Item -Path $ConfigFile -Destination "$ConfigFile.bak" -Force
    Write-Host "기존 설정 백업: $ConfigFile.bak"
}

# 설정 업데이트
$filterFile = [System.IO.Path]::GetTempFileName()
[System.IO.File]::WriteAllText($filterFile, '.mcpServers[$key] = {"command":"npx","args":["-y","mcp-remote",$url,"--transport","http-only"]}', [System.Text.UTF8Encoding]::new($false))
$json = (Get-Content $ConfigFile -Raw |
    jq --arg url $MCP_URL --arg key "Catch Up" -f $filterFile) -join "`n"
Remove-Item $filterFile -ErrorAction SilentlyContinue
if ($LASTEXITCODE -ne 0 -or !$json) {
    Write-Host "설정 파일 업데이트 실패." -ForegroundColor Red
    Exit-Script 1
}
[System.IO.File]::WriteAllText($ConfigFile, $json, [System.Text.UTF8Encoding]::new($false))

Write-Host ""
Write-Host "설치 완료." -ForegroundColor Green
Write-Host "Claude Desktop을 재시작하면 Catch Up MCP가 활성화됩니다."
Exit-Script 0
