#!/usr/bin/env bash
set -euo pipefail

MCP_URL="{{ mcp_url }}"
CONFIG_DIR="$HOME/Library/Application Support/Claude"
CONFIG_FILE="$CONFIG_DIR/claude_desktop_config.json"

_ensure_brew_path() {
    if [[ -f /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
}

echo "CatchUp MCP 설치"
echo ""

# Node.js
if command -v node &>/dev/null; then
    echo "Node.js $(node --version)"
else
    echo "Node.js 설치 중..."
    if ! command -v brew &>/dev/null; then
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || {
            echo "Homebrew 설치 실패. 직접 설치 후 다시 실행하세요: https://nodejs.org/ko/download"
            exit 1
        }
        _ensure_brew_path
    fi
    brew install node || {
        echo "Node.js 설치 실패. 직접 설치 후 다시 실행하세요: https://nodejs.org/ko/download"
        exit 1
    }
    echo "Node.js $(node --version) 설치됨"
fi

# Claude Desktop
if [[ ! -d "$CONFIG_DIR" ]]; then
    echo "Claude Desktop을 찾을 수 없습니다. 설치 후 다시 실행하세요: https://claude.ai/download"
    exit 1
fi

# jq
if ! command -v jq &>/dev/null; then
    _ensure_brew_path
    echo "jq 설치 중..."
    brew install jq || { echo "jq 설치 실패."; exit 1; }
fi

# config 파일
_is_new_file=false
if [[ ! -f "$CONFIG_FILE" ]]; then
    printf '{}' > "$CONFIG_FILE"
    _is_new_file=true
fi

# 기존 항목 확인
if jq -e '.mcpServers["Catch Up"]' "$CONFIG_FILE" &>/dev/null; then
    echo ""
    printf "'Catch Up' 설정이 이미 있습니까? 덮어쓰겠습니까? (y/N): "
    read -r answer || answer="N"
    if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        echo "취소됨."
        exit 0
    fi
fi

# 백업
if [[ "$_is_new_file" != "true" ]]; then
    cp "$CONFIG_FILE" "${CONFIG_FILE}.bak"
    echo "기존 설정 백업: ${CONFIG_FILE}.bak"
fi

# 설정 업데이트
FILTER_FILE=$(mktemp)
printf '.mcpServers[$key] = {"command":"npx","args":["-y","mcp-remote",$url,"--transport","http-only"]}' > "$FILTER_FILE"
UPDATED=$(jq --arg url "$MCP_URL" --arg key "Catch Up" -f "$FILTER_FILE" "$CONFIG_FILE"); JQ_EXIT=$?
rm -f "$FILTER_FILE"
if [[ $JQ_EXIT -ne 0 ]] || [[ -z "$UPDATED" ]]; then
    echo "설정 파일 업데이트 실패."
    exit 1
fi
printf '%s' "$UPDATED" > "$CONFIG_FILE"

echo ""
echo "설치 완료."
echo "Claude Desktop을 재시작하면 Catch Up MCP가 활성화됩니다."
echo ""
read -r -p "Enter를 누르면 종료됩니다." _
