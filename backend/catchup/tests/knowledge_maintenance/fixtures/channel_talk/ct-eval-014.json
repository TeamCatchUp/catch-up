      "message_type": "default",
      "person_type": "manager",
      "author": {
        "author_type": "manager",
        "manager_id": "manager-b6421e72a20c",
        "name": "캐치업 팀",
        "is_bot": false
      },
      "plain_text": "권한 관련 문의네요. 현재 개인 연결 방식인지, 관리자 계정으로 공간 전체를 연결한 상태인지 알려주실 수 있을까요?",
      "created_at": "2026-06-15T09:06:00Z",
      "updated_at": "2026-06-15T09:06:00Z",
      "is_private": false,
      "attachments": [],
      "buttons": [],
      "blocks": []
    },
    {
