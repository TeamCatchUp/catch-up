        "author_type": "customer",
        "user_id": "user-6b7d0b29238f",
        "name": "사용자 014",
        "is_bot": false
      },
      "plain_text": "관리자 계정으로 두 개 스페이스를 연결했습니다.",
      "created_at": "2026-06-15T09:08:00Z",
      "updated_at": "2026-06-15T09:08:00Z",
      "is_private": false,
      "attachments": [],
      "buttons": [],
      "blocks": []
    },
    {
