      "user_chat_id": "ct-eval-014",
      "message_type": "default",
      "person_type": "manager",
      "author": {
        "author_type": "manager",
        "manager_id": "manager-b6421e72a20c",
        "name": "캐치업 팀",
        "is_bot": false
      },
      "plain_text": "이 경우 캐치업 공간의 접근 범위와 원본 문서의 권한을 어떻게 운영할지 함께 확인해야 합니다.",
      "created_at": "2026-06-15T09:10:00Z",
      "updated_at": "2026-06-15T09:10:00Z",
      "is_private": false,
      "attachments": [],
      "buttons": [],
      "blocks": []
    },
    {
